{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tauri-app",
  "version": "0.1.0",
  "identifier": "com.shiqianshan.tauri-app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Navi",
        "width": 900,
        "height": 680,
        "minWidth": 700,
        "minHeight": 500
      },
      {
        "label": "live2d-companion",
        "url": "http://localhost:1420/live2d.html",
        "title": "",
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "width": 380,
        "height": 600,
        "visible": false,
        "resizable": false,
        "shadow": false,
        "x": 100,
        "y": 100
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "../../backend/dist/navi-backend"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}